extends Node
## الترجمة (عربي RTL / English) - تبديل من الإعدادات.
## Simple bilingual string table. Case texts use {"ar": "...", "en": "..."} dictionaries.

var lang: String = "ar"


func set_lang(l: String) -> void:
	lang = l if l in ["ar", "en"] else "ar"


func is_rtl() -> bool:
	return lang == "ar"


## نص من جدول الواجهة.
func t(key: String) -> String:
	var table: Dictionary = STR.get(lang, {})
	if table.has(key):
		return table[key]
	if STR["ar"].has(key):
		return STR["ar"][key]
	push_warning("Missing translation key: " + key)
	return key


func f(key: String, args: Array) -> String:
	return t(key) % args


## نص من بيانات القضية: إما نص عادي أو قاموس بلغات. لو الإنجليزي ناقص نرجع للعربي.
func pick(v: Variant) -> String:
	if v is Dictionary:
		if v.has(lang) and str(v[lang]) != "":
			return str(v[lang])
		return str(v.get("ar", v.get("en", "")))
	return str(v)


